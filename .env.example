# ============================================================================
# LazyPR Environment Configuration Template
# ============================================================================
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA versione o arquivo .env — adicione-o ao .gitignore
#
# cp .env.example .env
# ============================================================================

# ============================================================================
# LLM Provider Configuration
# ============================================================================

# Chave de API do Groq (https://console.groq.com)
# Obtenha em: https://console.groq.com/keys
# Requerido para chamadas de classificação semântica
GROQ_API_KEY=gsk_seu_token_aqui_nao_cole_token_real

# Modelo LLM a usar (padrão: llama3-8b-8192)
# Opções: llama3-8b-8192, llama3-70b-8192, mixtral-8x7b-32768, etc
# Consulte https://console.groq.com/docs/models para modelos disponíveis
LAZYPR_MODEL=llama3-8b-8192

# Limite máximo de caracteres do corpo do PR enviado ao LLM
# Evita estouro de contexto em prompts muito longos
# Padrão: 1500 (reduz custo e latência)
LAZYPR_MAX_BODY_CHARS=1500

# ============================================================================
# Cache e Persistência
# ============================================================================

# Diretório de cache de análises persistidas
# Padrão: .cache/analyses
# Será criado automaticamente se não existir
LAZYPR_CACHE_DIR=.cache/analyses

# ============================================================================
# Logging e Debug (Opcional)
# ============================================================================

# Habilitar logging verbose (true/false)
# Padrão: false
LAZYPR_VERBOSE_LOGGING=false

# ============================================================================
# Streamlit Configuration (Se executar UI)
# ============================================================================

# Número máximo de registros a carregar por sessão (padrão: 10000)
STREAMLIT_MAX_RECORDS=10000

# Tema da interface (light/dark)
# STREAMLIT_THEME=light
